{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tastebridge-hackathon",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/", "/index.html", "/tastebridge", "/safedesk"]
  },
  "ai": {"binding": "AI"},
  "d1_databases": [
    {"binding": "DB", "database_name": "tastebridge-hackathon", "migrations_dir": "migrations"}
  ],
  "observability": {"enabled": true}
}
