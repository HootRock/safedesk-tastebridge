MODEL_PROVIDER=codex
MODEL_NAME=gpt-6-luna
CODEX_ENABLED=false
CODEX_EXECUTABLE=codex
MODEL_BUDGET_CNY=0
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
DATA_DIR=./data
APP_MODE=live
PUBLIC_HOSTING=false

# Optional hosted planner. Free-provider accounts and credentials are not bundled.
# Keep the local defaults above for the SafeDesk Codex walkthrough.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL_NAME=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Groq is an alternative, enabled only with MODEL_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-20b
REMOTE_DB_URL=
REMOTE_DB_AUTH_TOKEN=
ALLOWED_HOSTS=
DAILY_MODEL_LIMIT=100
DAILY_QLOO_LIMIT=500
